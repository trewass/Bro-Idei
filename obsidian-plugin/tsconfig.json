{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "sourceMap": false,
    "strict": true,
    "types": ["node", "obsidian"],
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
